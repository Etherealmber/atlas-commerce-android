<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug-only: local development endpoints may use HTTP. Release keeps system defaults. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Trust locally installed development CAs only in debuggable builds. Never trust-all. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
